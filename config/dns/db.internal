$ORIGIN internal.
@       IN SOA  ns.internal. admin.internal. (
                1           ; serial
                3600        ; refresh
                600         ; retry
                86400       ; expire
                60          ; minimum TTL
        )
        IN NS   ns.internal.

ns                  IN A    172.20.0.2
kafka               IN A    172.20.0.10
schema-registry     IN A    172.20.0.20
